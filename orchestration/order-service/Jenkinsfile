pipeline {
    agent any

    environment {
        SERVICE_DIR = "orchestration/order-service"

        REGISTRY = "192.168.0.100:5000"
        IMAGE_NAME = "orchestration-order-service"

        NAMESPACE = "saga"
        DEPLOYMENT_NAME = "order-service"
        CONTAINER_NAME = "order-service"
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()

                git branch: 'main',
                    url: 'https://github.com/bangittest/Saga-Pattern.git'

                sh '''
                    echo "Latest commit:"
                    git log -1

                    echo "Workspace:"
                    pwd
                    ls -la

                    echo "Dockerfiles:"
                    find . -maxdepth 4 -name Dockerfile -print
                '''
            }
        }

        stage('Prepare Image Tag') {
            steps {
                script {
                    def shortCommit = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "main-${env.BUILD_NUMBER}-${shortCommit}"
                    env.FULL_IMAGE = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"

                    echo "Image tag: ${env.IMAGE_TAG}"
                    echo "Full image: ${env.FULL_IMAGE}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        echo "Build context:"
                        pwd
                        ls -la

                        docker build -t $FULL_IMAGE .
                    '''
                }
            }
        }

        stage('Push Image To Registry') {
            steps {
                sh '''
                    echo "Push image to registry:"
                    echo "$FULL_IMAGE"

                    docker push $FULL_IMAGE
                '''
            }
        }

        stage('Pre Deploy Check') {
            steps {
                sh '''
                    echo "Check Kubernetes context:"
                    kubectl config current-context

                    echo "Check namespace:"
                    kubectl get namespace $NAMESPACE

                    echo "Check deployment:"
                    kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE -o wide

                    echo "Check current image:"
                    kubectl get deployment $DEPLOYMENT_NAME \
                      -n $NAMESPACE \
                      -o jsonpath="{.spec.template.spec.containers[0].image}"

                    echo ""
                    echo "Check current imagePullPolicy:"
                    kubectl get deployment $DEPLOYMENT_NAME \
                      -n $NAMESPACE \
                      -o jsonpath="{.spec.template.spec.containers[0].imagePullPolicy}"

                    echo ""
                    echo "Check rollout strategy:"
                    kubectl get deployment $DEPLOYMENT_NAME \
                      -n $NAMESPACE \
                      -o jsonpath="{.spec.replicas}{' replicas, maxUnavailable='}{.spec.strategy.rollingUpdate.maxUnavailable}{', maxSurge='}{.spec.strategy.rollingUpdate.maxSurge}"

                    echo ""
                '''
            }
        }

        stage('Deploy To Rancher Kubernetes') {
            steps {
                sh '''
                    echo "Deploy image:"
                    echo "$FULL_IMAGE"

                    kubectl set image deployment/$DEPLOYMENT_NAME \
                      $CONTAINER_NAME=$FULL_IMAGE \
                      -n $NAMESPACE

                    kubectl rollout status deployment/$DEPLOYMENT_NAME \
                      -n $NAMESPACE \
                      --timeout=300s
                '''
            }
        }
    }

    post {
        success {
            sh '''
                echo "Deploy success!"

                echo "Deployment:"
                kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE -o wide

                echo "ReplicaSets:"
                kubectl get rs -n $NAMESPACE -l app=$DEPLOYMENT_NAME -o wide

                echo "Pods:"
                kubectl get pods -n $NAMESPACE -l app=$DEPLOYMENT_NAME -o wide

                echo "Rollout history:"
                kubectl rollout history deployment/$DEPLOYMENT_NAME -n $NAMESPACE
            '''
        }

        failure {
            sh '''
                echo "Build or rollout failed."
                echo "No automatic rollback."
                echo "Failed pods are kept for debugging."
                echo "Next build will set a new image and replace the failed rollout."

                echo "Deployment:"
                kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE -o wide || true

                echo "Deployment detail:"
                kubectl describe deployment $DEPLOYMENT_NAME -n $NAMESPACE || true

                echo "ReplicaSets:"
                kubectl get rs -n $NAMESPACE -l app=$DEPLOYMENT_NAME -o wide || true

                echo "Pods:"
                kubectl get pods -n $NAMESPACE -l app=$DEPLOYMENT_NAME -o wide || true

                echo "Describe pods:"
                kubectl describe pods -n $NAMESPACE -l app=$DEPLOYMENT_NAME || true

                echo "Current container logs:"
                kubectl logs -n $NAMESPACE -l app=$DEPLOYMENT_NAME \
                  --all-containers=true \
                  --tail=200 || true

                echo "Previous crashed container logs:"
                kubectl logs -n $NAMESPACE -l app=$DEPLOYMENT_NAME \
                  --all-containers=true \
                  --previous \
                  --tail=200 || true

                echo "Recent events:"
                kubectl get events -n $NAMESPACE --sort-by=.lastTimestamp || true

                echo "Final pod state:"
                kubectl get pods -n $NAMESPACE -l app=$DEPLOYMENT_NAME -o wide || true
            '''
        }
    }
}