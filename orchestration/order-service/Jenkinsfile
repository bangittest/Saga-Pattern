pipeline {
    agent any

    environment {
        SERVICE_DIR = "orchestration/order-service"

        REGISTRY = "192.168.0.101:30500"
        IMAGE_NAME = "orchestration-order-service"

        NAMESPACE = "saga"
        DEPLOYMENT_NAME = "order-service"
        CONTAINER_NAME = "order-service"
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()

                git branch: 'main',
                    url: 'https://github.com/bangittest/Saga-Pattern.git'

                sh '''
                    echo "Latest commit:"
                    git log -1

                    echo "Workspace:"
                    pwd
                    ls -la

                    echo "Dockerfiles:"
                    find . -maxdepth 4 -name Dockerfile -print
                '''
            }
        }

        stage('Prepare Image Tag') {
            steps {
                script {
                    def shortCommit = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "main-${env.BUILD_NUMBER}-${shortCommit}"
                    env.FULL_IMAGE = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"

                    echo "Image tag: ${env.IMAGE_TAG}"
                    echo "Full image: ${env.FULL_IMAGE}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        echo "Build context:"
                        pwd
                        ls -la

                        docker build -t $FULL_IMAGE .
                    '''
                }
            }
        }

        stage('Push Image To Registry') {
            steps {
                sh '''
                    echo "Push image to registry:"
                    echo "$FULL_IMAGE"

                    docker push $FULL_IMAGE
                '''
            }
        }

        stage('Trigger Kubernetes Deployment') {
            steps {
                sh '''
                    echo "Trigger Kubernetes deployment with image:"
                    echo "$FULL_IMAGE"

                    kubectl set image deployment/$DEPLOYMENT_NAME \
                      $CONTAINER_NAME=$FULL_IMAGE \
                      -n $NAMESPACE

                    echo "Deployment image updated."
                    echo "Jenkins will not wait for pods to become Ready."
                '''
            }
        }
    }
    post {
        success {
            sh '''
                echo "Pipeline success."
                echo "Image was built, pushed, and Kubernetes deployment was triggered."
            '''
        }

        failure {
            sh '''
                echo "Pipeline failed."
                echo "Stop immediately. Skip Kubernetes diagnostics in post action."
            '''
        }

        aborted {
            sh '''
                echo "Pipeline aborted."
            '''
        }
    }

//     post {
